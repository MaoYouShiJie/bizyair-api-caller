{
  "name": "bizyair-clone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:backend": "node backend/server.cjs",
    "dev:electron": "set VITE_DEV_SERVER_URL=http://localhost:5173 && electron .",
    "build": "tsc -b && vite build",
    "electron": "set NODE_ENV=production && electron .",
    "electron:prod": "vite build && chcp 65001>nul && set NODE_ENV=production&& electron .",
    "dist": "vite build && npx electron-builder --win --x64",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.bizyair.modelzoo",
    "productName": "BizyAirAPI 调用",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "icon.png"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.png"
    }
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "express": "^4.21.0",
    "http-proxy-middleware": "^3.0.0",
    "multer": "^2.1.1",
    "playwright": "^1.60.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^35.1.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
